{
  "db_name": "PostgreSQL",
  "query": "SELECT id, kind, value FROM session_secrets\n               WHERE ($3::uuid IS NULL OR id > $3)\n                 AND CASE WHEN length(value) >= 3\n                     THEN get_byte(value, 1) * 256 + get_byte(value, 2) <> $1\n                     ELSE false END\n               ORDER BY id LIMIT $2",

  "db_name": "PostgreSQL",
  "query": "SELECT id, secret FROM connector_credentials\n             WHERE ($3::uuid IS NULL OR id > $3)\n               AND CASE WHEN length(secret) >= 3\n                   THEN get_byte(secret, 1) * 256 + get_byte(secret, 2) <> $1\n                   ELSE false END\n             ORDER BY id LIMIT $2",

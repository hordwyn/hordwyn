  "query": "SELECT id, user_id, item_id, kind, status, status_hlc, completed_at,\n                    completed_undated, rating, rating_hlc, notes,\n                    notes_hlc, added_at FROM library_entries\n             WHERE user_id = $1\n               AND ($2::timestamptz IS NULL\n                    OR (added_at <= $2 AND (added_at < $2 OR id < $3::uuid)))\n             ORDER BY added_at DESC, id DESC LIMIT $4",

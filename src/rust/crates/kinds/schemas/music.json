{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Attributes of a music release (album, EP, single).",
  "properties": {
    "artists": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "duration_seconds": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "genres": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "label": {
      "type": [
        "string",
        "null"
      ]
    },
    "release_date": {
      "format": "date",
      "type": [
        "string",
        "null"
      ]
    },
    "release_type": {
      "description": "`album`, `ep`, `single`, `compilation`, ...",
      "type": [
        "string",
        "null"
      ]
    },
    "track_count": {
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "title": "MusicAttributes",
  "type": "object"
}

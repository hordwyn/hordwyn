{
  "$defs": {
    "SeasonInfo": {
      "additionalProperties": false,
      "description": "One season of an episodic item.",
      "properties": {
        "air_date": {
          "description": "First air date of the season (WP4-7; TMDB `seasons[].air_date`).",
          "format": "date",
          "type": [
            "string",
            "null"
          ]
        },
        "episode_count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "number": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "number",
        "episode_count"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Attributes of an anime.",
  "properties": {
    "episode_count": {
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "format": {
      "description": "`tv`, `movie`, `ova`, `ona`, `special`, ...",
      "type": [
        "string",
        "null"
      ]
    },
    "genres": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "seasons": {
      "items": {
        "$ref": "#/$defs/SeasonInfo"
      },
      "type": "array"
    },
    "start_date": {
      "format": "date",
      "type": [
        "string",
        "null"
      ]
    },
    "studios": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "title": "AnimeAttributes",
  "type": "object"
}

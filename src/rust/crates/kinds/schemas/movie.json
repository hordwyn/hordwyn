{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Attributes of a movie.",
  "properties": {
    "genres": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "original_language": {
      "type": [
        "string",
        "null"
      ]
    },
    "release_date": {
      "format": "date",
      "type": [
        "string",
        "null"
      ]
    },
    "runtime_minutes": {
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "title": "MovieAttributes",
  "type": "object"
}

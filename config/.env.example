# Copy to config/.env (git-ignored). Every key the application reads from the environment.
# Values are left empty on purpose. Any configuration key can also be set as
# APP__<SECTION>__<KEY> (see the configuration reference in the docs).
POSTGRES_PASSWORD=
MEILI_MASTER_KEY=
APP__DATABASE__URL=
APP__SEARCH__MEILI_URL=
APP__SEARCH__MEILI_MASTER_KEY=
APP__AUTH__OIDC__CLIENT_SECRET=
APP__STORAGE__S3__ACCESS_KEY_ID=
APP__STORAGE__S3__SECRET_ACCESS_KEY=
# Root keys of the optional RustFS service (compose profile s3)
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Connector keys: APP__CONNECTORS__<ID>__API_KEY, or the short form KK_<ID>_API_KEY
APP__CONNECTORS__TMDB__API_KEY=
KK_TMDB_API_KEY=
APP__CONNECTORS__IGDB__API_KEY=
KK_IGDB_API_KEY=
APP__CONNECTORS__TVDB__API_KEY=
KK_TVDB_API_KEY=
APP__CONNECTORS__PODCASTINDEX__API_KEY=
KK_PODCASTINDEX_API_KEY=
# BoardGameGeek application token (Q5); the connector is not built yet (R-P2)
KK_BGG_TOKEN=
# Notifications
APP__NOTIFY__SMTP__PASSWORD=

# Copy to config/.env (git-ignored). Every key the application and the compose files read
# from the environment. Values are left empty on purpose. Any configuration key can also be
# set as APP__<SECTION>__<KEY> (see the configuration reference in the docs).
#
# --- First run (docs: "Install and first run", "Behind a reverse proxy") ---
# Required by compose, no defaults. Letters and digits only (the database password becomes
# part of a URL), for example: openssl rand -hex 24
# Only for a NEW installation: an existing database keeps its password, the variable is
# applied when the empty data directory is created
POSTGRES_PASSWORD=
# 16 bytes or more
MEILI_MASTER_KEY=
# The URL people open, as the browser sees it, e.g. https://tracker.example.org
# (links in emails, OIDC redirects, share links, the cross-site check). Default:
# http://localhost:3000
APP__SERVER__PUBLIC_URL=
# The reverse proxy's address or network as a list, e.g. ["172.16.0.0/12"] or ["192.168.1.10"]
# (its X-Forwarded-For is believed for audit rows and for the sign-in limits per client
# address; without it every visitor counts as the proxy). Default: none
APP__SERVER__TRUSTED_PROXIES=
# true (default) needs https at the public URL; false only for a plain-http test on a LAN:
# with true over plain http the browser drops the session cookie and nobody can sign in
APP__AUTH__SECURE_COOKIES=
# Seconds a browser remembers "HTTPS only" for the host (Strict-Transport-Security; sent only
# when the public URL is https). Default 31536000 (one year); 0 sends no such header (while
# trying an address out, or when the proxy sends its own)
APP__SERVER__HSTS_MAX_AGE_SECS=
# true sends the content security policy report-only (the browser console lists what it
# would refuse, nothing is refused). Default false; only for finding a fault
APP__SERVER__CSP_REPORT_ONLY=
# Time limits for requests, in seconds. Head of a request (also how long an idle keep-alive
# connection is kept, so stay above the proxy's own keep-alive time; default 150), longest
# pause inside a request body (default 30), a whole request body except the import upload
# (default 60), the whole import upload (default 1800)
APP__SERVER__HEADER_READ_TIMEOUT_SECS=
APP__SERVER__BODY_IDLE_TIMEOUT_SECS=
APP__SERVER__BODY_READ_TIMEOUT_SECS=
APP__SERVER__IMPORT_READ_TIMEOUT_SECS=
# Sign-in limits (docs: Operations, "Sign-in limits"). Defaults: 3 free failures per account
# and client address, then a wait of 1 s that doubles up to 300 s; 30 failures per client
# address in 15 minutes; 8 password checks at once
APP__AUTH__THROTTLE__FREE_FAILURES=
APP__AUTH__THROTTLE__DELAY_BASE_SECS=
APP__AUTH__THROTTLE__DELAY_MAX_SECS=
APP__AUTH__THROTTLE__WINDOW_MINUTES=
APP__AUTH__THROTTLE__ADDRESS_FAILURES=
APP__AUTH__THROTTLE__VERIFY_CONCURRENCY=
# Hosts that may be on a private address although the server would not call one there, for
# data sources, sign-in providers, the mail server and notification channels alike: a list of
# host, host:port or *.domain, e.g. ["idp.lan", "10.0.0.5:8443", "relay.lan:25"] (docs:
# Operations, "What the server connects to"). Default: none
APP__OUTBOUND__ALLOW_PRIVATE_HOSTS=
# Host address compose publishes port 3000 on. Default 127.0.0.1 (reverse proxy on the same
# host); a LAN address when the proxy runs on another machine
APP_PUBLISH_ADDR=
# Host port compose publishes the application on. Default 3000; another one for a second
# copy beside the live instance (docs: Operations, "Restore rehearsal beside the live
# instance")
APP_PUBLISH_PORT=
# Image every container of the app runs. The published image with its version tag (docs:
# Install, "Start", and Operations, "Upgrade"), e.g. <registry>/<project>:1.0.0; without a
# value the image is built from this checkout as localhost/tracker-app:local. Another name
# for a second copy beside the live instance (Operations, "Restore rehearsal")
APP_IMAGE=
# Role of the app container: all (default), or web when worker services run beside it
APP_ROLE=
# Parallel compile jobs of the image build. Default 2; 1 on hosts with less than 8 GB free
CARGO_BUILD_JOBS=
#
# --- Services ---
# compose sets these three for the app container; set them only outside compose
APP__DATABASE__URL=
APP__SEARCH__MEILI_URL=
APP__SEARCH__MEILI_MASTER_KEY=
APP__AUTH__OIDC__CLIENT_SECRET=
APP__STORAGE__S3__ACCESS_KEY_ID=
APP__STORAGE__S3__SECRET_ACCESS_KEY=
# Root keys of the optional RustFS service (src/docker/compose.s3.yml), required there
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Connector keys: APP__CONNECTORS__<ID>__API_KEY, or the short form SOURCE_<ID>_API_KEY
# (docs: Connectors and attribution). Open Library and Wikidata need no key.
# TMDB: the API read access token (the long one), not the short API key
APP__CONNECTORS__TMDB__API_KEY=
SOURCE_TMDB_API_KEY=
# IGDB: <client_id>:<client_secret> of a Twitch application
APP__CONNECTORS__IGDB__API_KEY=
SOURCE_IGDB_API_KEY=
# TheTVDB: <apikey>, or <apikey>:<pin> for a key that comes with a PIN
APP__CONNECTORS__TVDB__API_KEY=
SOURCE_TVDB_API_KEY=
# Podcast Index: <key>:<secret>
APP__CONNECTORS__PODCASTINDEX__API_KEY=
SOURCE_PODCASTINDEX_API_KEY=
# Secrets at rest: key file (recommended) or the keys themselves (v2:<base64>,v1:<base64>).
# In the container image leave the key file empty: it is /data/secrets.key in the app-data
# volume, next to the blob directory /data/blobs, never inside it. Back it up with the
# database dump (docs: Operations, Backup)
APP__SECRETS__KEY_FILE=
APP__SECRETS__KEYS=
# tests only: a temporary key, values unreadable after a restart (true/false)
APP__SECRETS__EPHEMERAL=
# home or hosted; when set, the admin area shows it read-only
APP__INSTANCE__HOSTING=
# Your contact as the operator: an e-mail address (preferred) or an https URL (at most 200
# characters). Sent in the User-Agent of requests to Open Library and Wikidata, to no
# other source, so they can reach you; Wikidata (board games) is not asked without one.
# When set here, the admin area shows it read-only; otherwise set it on Admin > Data
# sources. Long form:
# APP__INSTANCE__OPERATOR_CONTACT
SOURCE_OPERATOR_CONTACT=
# count the logging funnel as daily totals without users (true/false, default true); when
# set, the admin area shows it read-only
APP__USAGE__FUNNEL=
# Notifications
APP__NOTIFY__SMTP__PASSWORD=
# May sign-in providers, the mail server and notification channels be on private addresses?
# Not set: channels no; providers and mail yes on a home instance, no on a hosted one.
# true or false decides for all three
APP__NOTIFY__ALLOW_PRIVATE_TARGETS=
